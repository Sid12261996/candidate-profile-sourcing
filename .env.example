# candidate-profile-sourcing environment template.
# Copy to .env and fill in. run-local.sh never overwrites existing values.

# --- LLM providers ---
# For scoring rubric calls (fill at least one):
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# For query expansion (required):
CLAUDE_API_KEY=

# --- Cron model pin (optional; leave empty to configure later via dashboard) ---
HERMES_CRON_PROVIDER=
HERMES_CRON_MODEL=

# --- Dashboard basic auth (required: dashboard binds 0.0.0.0 inside the container;
#     run-local.sh generates PASSWORD and SECRET on first bootstrap if left empty) ---
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- Notification delivery target for the sourcing cron job ---
# local | telegram | telegram:<chat_id> | discord | slack | email | ...
HERMES_DELIVER_TARGET=local

# --- Local-mode queue paths (storage.backend=local; defaults shown) ---
CPS_JDS_PENDING_DIR=data/jds-pending
CPS_JDS_PROCESSED_DIR=data/jds-processed
CPS_JDS_FAILED_DIR=data/jds-failed
CPS_EXPORTS_INBOX_DIR=data/exports-inbox

# --- SearXNG ---
SEARXNG_SECRET=
